---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Content from '~/components/widgets/Content.astro';
import Steps from '~/components/widgets/Steps.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import FAQs from '~/components/widgets/FAQs.astro';

const metadata = {
  title: 'Managed IT Services Pune | 24/7 Remote IT Support India - TechResona',
  description: 'Professional managed IT services in Pune with 24/7 remote support. Proactive IT infrastructure monitoring, managed help desk services, and comprehensive IT maintenance plans for businesses across India.',
  keywords: 'managed IT services Pune, 24/7 remote IT support India, IT infrastructure monitoring, proactive IT maintenance, managed help desk services, cloud infrastructure management, IT support for small business, managed service provider Pune, remote IT support near me, network monitoring services, server management India, IT outsourcing Pune, help desk support services, technology management solutions, cybersecurity monitoring services',
  canonical: 'https://techresona.com/managed-services',
};
---

<Layout metadata={metadata}>
  <!-- Hero Section -->
  <Hero
    tagline="Managed IT Services"
    title="Professional Managed IT Services with 24/7 Support"
    subtitle="Keep your business technology running smoothly with comprehensive managed IT services, proactive monitoring, and expert remote support."
    actions={[
      { variant: 'primary', text: 'Request Free Consultation', href: '/contact' },
      { text: 'View Services', href: '#services' },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1695668548342-c0c1ad479aee?crop=entropy&cs=srgb&fm=jpg&ixid=M3w4NjA1MDZ8MHwxfHNlYXJjaHw0fHxJVCUyMHN1cHBvcnQlMjBzZXJ2ZXIlMjBtb25pdG9yaW5nfGVufDB8fHx8MTc3MDE4OTIzNHww&ixlib=rb-4.1.0&q=85',
      alt: 'Managed IT services and 24/7 remote support infrastructure',
    }}
  >
    <Fragment slot="subtitle">
      <span class="font-semibold">500+ businesses trust us</span> for reliable IT operations.
      Get expert IT support without the cost of hiring full-time staff.
    </Fragment>
  </Hero>

  <!-- Stats Section -->
  <section class="bg-blue-50 dark:bg-slate-800 py-12">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div>
          <div class="text-4xl font-bold text-blue-600 dark:text-blue-400 mb-2">24/7</div>
          <div class="text-gray-600 dark:text-gray-300">Monitoring & Support</div>
        </div>
        <div>
          <div class="text-4xl font-bold text-blue-600 dark:text-blue-400 mb-2">&lt;15min</div>
          <div class="text-gray-600 dark:text-gray-300">Average Response Time</div>
        </div>
        <div>
          <div class="text-4xl font-bold text-blue-600 dark:text-blue-400 mb-2">99.9%</div>
          <div class="text-gray-600 dark:text-gray-300">Uptime Guarantee</div>
        </div>
        <div>
          <div class="text-4xl font-bold text-blue-600 dark:text-blue-400 mb-2">500+</div>
          <div class="text-gray-600 dark:text-gray-300">Businesses Supported</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Introduction Content -->
  <Content
    title="Why Choose TechResona for Managed IT Services?"
    items={[
      {
        title: 'Reduced Downtime',
        description: 'Proactive monitoring and maintenance minimize system failures and keep your business running smoothly.',
      },
      {
        title: 'Predictable IT Costs',
        description: 'Fixed monthly fees eliminate unexpected IT expenses and make budgeting easier for your business.',
      },
      {
        title: 'Expert Team Access',
        description: 'Get access to a full team of IT specialists without the cost of hiring full-time employees.',
      },
      {
        title: 'Enhanced Security',
        description: 'Continuous security monitoring and updates protect your business from evolving cyber threats.',
      },
    ]}
  >
    <Fragment slot="content">
      <p class="text-lg mb-4">
        TechResona delivers comprehensive <strong>managed IT services</strong> that keep your business technology 
        running smoothly around the clock. Our expert team provides <strong>24/7 remote IT support in India</strong>, 
        proactive infrastructure monitoring, and complete IT maintenance solutions designed to minimize downtime and 
        maximize productivity.
      </p>
      <p class="text-lg">
        With our managed services, you get a dedicated IT team without the overhead of hiring full-time staff. 
        We handle everything from helpdesk support to infrastructure monitoring, allowing you to focus on your 
        core business while we ensure your technology works flawlessly.
      </p>
    </Fragment>
  </Content>

  <!-- Core Services -->
  <Features
    id="services"
    tagline="Our Managed IT Services"
    title="Comprehensive IT Management Solutions"
    subtitle="From 24/7 monitoring to proactive maintenance and expert support."
    items={[
      {
        title: '24/7 IT Infrastructure Monitoring',
        description: 'Continuous monitoring of your entire IT infrastructure including servers, networks, and applications with automated alert systems and proactive issue resolution.',
        icon: 'tabler:eye',
      },
      {
        title: 'Remote IT Support Services',
        description: 'Expert technical support delivered remotely with multi-tier support structure, screen sharing, issue tracking, and software installation.',
        icon: 'tabler:device-desktop',
      },
      {
        title: 'Managed Help Desk Services',
        description: 'Professional help desk team available via phone, email, or chat with ticket management, user training, and detailed reporting.',
        icon: 'tabler:headset',
      },
      {
        title: 'Proactive IT Maintenance Plans',
        description: 'Scheduled maintenance including system updates, performance optimization, security assessments, and backup verification.',
        icon: 'tabler:tools',
      },
      {
        title: 'Cloud Infrastructure Management',
        description: 'Complete management of AWS, Azure, and Google Cloud platforms with resource optimization, cost control, and disaster recovery.',
        icon: 'tabler:cloud',
      },
      {
        title: 'Cybersecurity Monitoring',
        description: 'Continuous security monitoring with intrusion detection, firewall management, antivirus protection, and incident response.',
        icon: 'tabler:shield-check',
      },
    ]}
  />


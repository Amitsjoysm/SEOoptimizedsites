    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold mb-4">Flexible Service Plans</h2>
        <p class="text-lg text-gray-600 dark:text-gray-300">Choose the plan that matches your business needs</p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-8">
        <!-- Essential Plan -->
        <div class="bg-white dark:bg-slate-900 p-8 rounded-lg shadow-lg">
          <h3 class="text-2xl font-bold mb-4">Essential Plan</h3>
          <p class="text-gray-600 dark:text-gray-300 mb-6">Perfect for small businesses needing basic IT support and monitoring.</p>
          <ul class="space-y-3 mb-8">
            <li class="flex items-start">
              <span class="text-green-500 mr-2">✓</span>
              <span>Business hours help desk (9 AM - 6 PM)</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-500 mr-2">✓</span>
              <span>Basic infrastructure monitoring</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-500 mr-2">✓</span>
              <span>Monthly system maintenance</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-500 mr-2">✓</span>
              <span>Email and phone support</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-500 mr-2">✓</span>
              <span>4-hour response time</span>
            </li>
          </ul>
          <a href="/contact" class="block text-center bg-blue-600 text-white py-3 px-6 rounded-lg hover:bg-blue-700 transition">Get Started</a>
        </div>

        <!-- Professional Plan -->
        <div class="bg-blue-600 text-white p-8 rounded-lg shadow-xl transform md:scale-105">
          <div class="bg-yellow-400 text-blue-900 text-sm font-bold px-3 py-1 rounded-full inline-block mb-4">POPULAR</div>
          <h3 class="text-2xl font-bold mb-4">Professional Plan</h3>
          <p class="text-blue-100 mb-6">Ideal for growing businesses requiring comprehensive IT management.</p>
          <ul class="space-y-3 mb-8">
            <li class="flex items-start">
              <span class="text-yellow-400 mr-2">✓</span>
              <span>24/7 help desk and monitoring</span>
            </li>
            <li class="flex items-start">
              <span class="text-yellow-400 mr-2">✓</span>
              <span>Proactive maintenance and optimization</span>
            </li>
            <li class="flex items-start">
              <span class="text-yellow-400 mr-2">✓</span>
              <span>Security monitoring and updates</span>
            </li>
            <li class="flex items-start">
              <span class="text-yellow-400 mr-2">✓</span>
              <span>Cloud infrastructure management</span>
            </li>
            <li class="flex items-start">
              <span class="text-yellow-400 mr-2">✓</span>
              <span>1-hour priority response time</span>
            </li>
            <li class="flex items-start">
              <span class="text-yellow-400 mr-2">✓</span>
              <span>Quarterly IT strategy reviews</span>
            </li>
          </ul>
          <a href="/contact" class="block text-center bg-white text-blue-600 py-3 px-6 rounded-lg hover:bg-gray-100 transition font-semibold">Get Started</a>
        </div>

        <!-- Enterprise Plan -->
        <div class="bg-white dark:bg-slate-900 p-8 rounded-lg shadow-lg">
          <h3 class="text-2xl font-bold mb-4">Enterprise Plan</h3>
          <p class="text-gray-600 dark:text-gray-300 mb-6">Complete IT management for large organizations.</p>
          <ul class="space-y-3 mb-8">
            <li class="flex items-start">
              <span class="text-green-500 mr-2">✓</span>
              <span>Dedicated account manager</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-500 mr-2">✓</span>
              <span>Custom SLA agreements</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-500 mr-2">✓</span>
              <span>Advanced security and compliance</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-500 mr-2">✓</span>
              <span>Disaster recovery planning</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-500 mr-2">✓</span>
              <span>15-minute critical response time</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-500 mr-2">✓</span>
              <span>Monthly executive reporting</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-500 mr-2">✓</span>
              <span>On-site support options</span>
            </li>
          </ul>
          <a href="/contact" class="block text-center bg-blue-600 text-white py-3 px-6 rounded-lg hover:bg-blue-700 transition">Get Started</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Advanced Features -->
  <Features2
    title="Advanced IT Management Capabilities"
    tagline="Enterprise Solutions"
    columns={3}
    items={[
      {
        title: 'Backup & Disaster Recovery',
        description: 'Automated backup solutions with regular testing and rapid disaster recovery capabilities.',
        icon: 'tabler:server',
      },
      {
        title: 'Network Optimization',
        description: 'Continuous network monitoring and optimization for maximum performance and reliability.',
        icon: 'tabler:network',
      },
      {
        title: 'Patch Management',
        description: 'Automated security patch deployment across all systems to maintain security compliance.',
        icon: 'tabler:refresh',
      },
      {
        title: 'Asset Management',
        description: 'Complete hardware and software inventory tracking with lifecycle management.',
        icon: 'tabler:list-check',
      },
      {
        title: 'Vendor Management',
        description: 'Coordinate with your technology vendors for seamless support and issue resolution.',
        icon: 'tabler:users',
      },
      {
        title: 'Compliance Reporting',
        description: 'Regular compliance audits and reporting for industry regulations and standards.',
        icon: 'tabler:certificate',
      },
    ]}
  />

  <!-- Industries Served -->
  <Content
    isReversed
    title="Industries We Support"
    items={[
      {
        title: 'Healthcare & Medical',
        description: 'HIPAA-compliant IT support ensuring patient data security and system availability.',
      },
      {
        title: 'Financial Services',
        description: 'Secure IT infrastructure management with strict compliance requirements.',
      },
      {
        title: 'Professional Services',
        description: 'IT support for law firms, consulting agencies, and accounting firms.',
      },
      {
        title: 'Manufacturing',
        description: 'Robust IT infrastructure supporting production systems and supply chain.',
      },
      {
        title: 'Retail & E-commerce',
        description: 'High-availability support ensuring online stores and POS systems run without interruption.',
      },
      {
        title: 'Education',
        description: 'IT support for schools, colleges, and training institutes with student data management.',
      },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Trusted Across Multiple Sectors

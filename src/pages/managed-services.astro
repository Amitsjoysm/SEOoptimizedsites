    title="Technologies We Manage"
    tagline="Comprehensive Expertise"
    columns={4}
    items={[
      {
        title: 'Windows Server',
        description: 'Complete management',
        icon: 'tabler:brand-windows',
      },
      {
        title: 'Linux Systems',
        description: 'Ubuntu, CentOS, RHEL',
        icon: 'tabler:brand-ubuntu',
      },
      {
        title: 'AWS Cloud',
        description: 'Amazon Web Services',
        icon: 'tabler:brand-aws',
      },
      {
        title: 'Microsoft Azure',
        description: 'Cloud platform',
        icon: 'tabler:brand-azure',
      },
      {
        title: 'VMware',
        description: 'Virtualization',
        icon: 'tabler:server',
      },
      {
        title: 'Office 365',
        description: 'Microsoft 365',
        icon: 'tabler:mail',
      },
      {
        title: 'Network Security',
        description: 'Firewall & VPN',
        icon: 'tabler:shield',
      },
      {
        title: 'Backup Solutions',
        description: 'Veeam, Acronis',
        icon: 'tabler:database',
      },
    ]}
  />

  <!-- FAQs -->
  <FAQs
    title="Frequently Asked Questions"
    tagline="Got Questions?"
    items={[
      {
        title: 'What are managed IT services?',
        description: "Managed IT services involve outsourcing your company's IT operations to a specialized provider who proactively monitors, manages, and maintains your IT infrastructure. This includes servers, networks, security, help desk support, and more, typically for a fixed monthly fee.",
      },
      {
        title: 'How quickly can you respond to IT issues?',
        description: 'Response times vary by service plan. Our Essential plan offers 4-hour response, Professional plan provides 1-hour response, and Enterprise plan guarantees 15-minute response for critical issues. Our 24/7 monitoring often allows us to resolve issues before you even notice them.',
      },
      {
        title: 'Can you support our existing IT infrastructure?',
        description: 'Yes, we work with all major technology platforms and can seamlessly integrate with your existing infrastructure. We perform a comprehensive assessment before onboarding to ensure smooth transition and optimal service delivery.',
      },
      {
        title: 'What is included in proactive maintenance?',
        description: 'Proactive maintenance includes regular system updates, security patches, performance optimization, backup verification, hardware health monitoring, and preventive measures to avoid system failures. This helps prevent issues before they cause downtime.',
      },
      {
        title: 'How does remote support work?',
        description: 'Our technicians use secure remote access tools to connect to your systems and resolve issues without requiring on-site visits. This allows for faster response times and immediate problem resolution. For issues requiring physical presence, we coordinate on-site support.',
      },
      {
        title: 'What are the costs of managed IT services?',
        description: 'Pricing is based on factors including number of users, devices, servers, required service levels, and specific needs. We offer transparent, fixed monthly pricing that makes budgeting predictable. Contact us for a customized quote based on your requirements.',
      },
    ]}
  />

  <!-- Call to Action -->
  <CallToAction
    title="Ready to Experience Worry-Free IT?"
    subtitle="Let our expert team handle your IT infrastructure while you focus on growing your business. Get a free consultation today."

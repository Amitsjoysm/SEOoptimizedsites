---
// Image Preloader Component
// Preloads critical images for faster perceived performance
const preloadImages = [
  '/images/techresona-logo-optimized.png',
  '/favicons/favicon-32x32.png',
];
---

<!-- Preconnect to critical origins for faster resource loading -->
<link rel="preconnect" href="https://images.unsplash.com" crossorigin />
<link rel="dns-prefetch" href="https://images.unsplash.com" />

<!-- Preload critical font files to prevent FOUT -->
<link rel="preload" href="/node_modules/@fontsource-variable/inter/files/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />

<!-- Preload critical images -->
{preloadImages.map((src) => (
  <link rel="preload" as="image" href={src} fetchpriority="high" />
))}

<!-- Critical CSS to prevent FOUC (Flash of Unstyled Content) -->
<style is:inline>
  /* Minimal critical styles to prevent flash of unstyled content */
  /* Cross-browser compatible base styles */
  html {
    font-family: 'Inter Variable', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    font-display: swap;
  }
  
  body {
    margin: 0;
    padding: 0;
    min-height: 100vh;
  }

  /* Prevent layout shift while loading */
  #main-content {
    min-height: 100vh;
  }
  
  /* Reserve space for hero section to prevent CLS */
  .hero-image-container {
    min-height: 576px;
  }
  
  /* Ensure images don't stretch - Critical for logo */
  img {
    max-width: 100%;
    height: auto;
    object-fit: contain;
  }
  
  /* Picture element fixes for older browsers */
  picture {
    display: inline-block;
  }
  
  picture img {
    display: block;
    width: auto;
    height: auto;
  }
  
  /* Prevent invisible text during font loading (FOIT) */
  @font-face {
    font-family: 'Inter Variable';
    font-display: swap;
  }
</style>

---
import '@fontsource-variable/inter';
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    /* TechResona Brand Colors */
    --aw-color-primary: rgb(1 97 239); /* Blue #0161EF */
    --aw-color-secondary: rgb(1 84 207); /* Darker Blue */
    --aw-color-accent: rgb(255 107 53); /* Orange #FF6B35 */

    --aw-color-text-heading: rgb(0 0 0);
    --aw-color-text-default: rgb(16 16 16);
    --aw-color-text-muted: rgb(16 16 16 / 66%);
    --aw-color-bg-page: rgb(255 255 255);

    --aw-color-bg-page-dark: rgb(3 6 32);

    ::selection {
      background-color: rgba(1, 97, 239, 0.2);
      color: rgb(0 0 0);
    }
  }

  .dark {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    /* TechResona Brand Colors - Dark Mode */
    --aw-color-primary: rgb(1 97 239); /* Blue #0161EF */
    --aw-color-secondary: rgb(1 84 207); /* Darker Blue */
    --aw-color-accent: rgb(255 107 53); /* Orange #FF6B35 */

    --aw-color-text-heading: rgb(247, 248, 248);
    --aw-color-text-default: rgb(229 236 246);
    --aw-color-text-muted: rgb(229 236 246 / 66%);
    --aw-color-bg-page: rgb(3 6 32);

    ::selection {
      background-color: rgba(1, 97, 239, 0.3);
      color: rgb(255 255 255);
    }
  }

  /* Additional TechResona Brand Styles */
  .text-accent {
    color: var(--aw-color-accent);
  }

  .bg-accent {
    background-color: var(--aw-color-accent);
  }

  .hover\:bg-accent:hover {
    background-color: var(--aw-color-accent);
  }

  .border-accent {
    border-color: var(--aw-color-accent);
  }
</style>